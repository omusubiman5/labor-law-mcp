{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/mcp.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/mcp",
      "dest": "/api/mcp.ts"
    },
    {
      "src": "/MCP",
      "dest": "/api/mcp.ts"
    },
    {
      "src": "/(.*)",
      "status": 404
    }
  ]
}
